{{!
    @template local_shopping_cart/shopping_cart_item

    This template will render the shopping_cart items.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * All data attributes are required

    Context variables required for this template:
    * userid the logged in user id
    * urls The URLs for the popover

    Example context (json):
    {
        "itemid": 3,
        "userid":3588,
        "componentname": "mod_booking",
        "area": "main",
        "price": 133,
        "expirationtime": 1642155164,
        "itemname": "Tenniscourse",
        "currency": "EUR",
        "iscashier": false,
        "nodelete": false
    }
}}

{{! role="listitem" (matching the role="list" of the container): the items are divs for layout
    reasons, this gives a screen reader the "3 items" overview without changing the markup. }}
<div id="item-{{componentname}}-{{area}}-{{itemid}}"
    role="listitem"
    class="shopping-cart-item clearfix"
    data-price='{{price}}'
    data-name='{{itemname}}'
    data-component='{{componentname}}'
    data-area='{{area}}'
    data-itemid='{{itemid}}'
    data-item="shopping_cart_item"
    data-currency='{{currency}}'
    data-userid='{{userid}}'>
    <span class="item-name">
        {{#imageurl}}
            {{! Accessibility notice: This is a decorative image and should not show up in screen readers.
            So keep alt attribute empty. }}
            <img alt="" class="sc-cart-item-image" src="{{.}}">
        {{/imageurl}}
        {{^imageurl}}
            {{! Accessibility notice: This is a decorative image and should not show up in screen readers.
            So keep alt attribute empty. }}
            <img alt="" class="sc-cart-item-image" src="{{wwwroot}}/local/shopping_cart/pix/cart.png">
        {{/imageurl}}
    </span>
    <div class="item-content">
        <div>
            <span class="itemname">
                {{itemname}}
            </span>
            <span class="number_of_items">
                {{nritemsstring}}
            </span>
            {{#multipliable}}
                {{! Real buttons: as <i data-action> they could only be clicked with a mouse and were
                    invisible to assistive technology (aria-hidden on top of that). }}
                <span class="multipliable_buttons">
                    {{! The FontAwesome classes must sit on a nested <i>, not on the button itself:
                        .sc-icon-button resets the font to inherit, which overrides the icon font. }}
                    <button type="button" class="sc-icon-button" data-action="decrease"
                        aria-label="{{#str}} decreaseamount, local_shopping_cart, {{itemname}} {{/str}}"><i
                        class="fa fa-minus-circle" aria-hidden="true"></i></button><button
                        type="button" class="sc-icon-button" data-action="increase"
                        aria-label="{{#str}} increaseamount, local_shopping_cart, {{itemname}} {{/str}}"><i
                        class="fa fa-plus-circle" aria-hidden="true"></i></button>
                </span>
            {{/multipliable}}
            <span>
                {{#installment}}
                    ({{#str}} allowinstallment, local_shopping_cart {{/str}})
                {{/installment}}
            </span>
            {{#iscashier}}
                <span class="item-button pull-right">
                    <button type="button" class="sc-icon-button shoppingcart-discount-icon ps-2"
                    aria-label="{{#str}} applydiscountitem, local_shopping_cart, {{itemname}} {{/str}}"
                    data-item="shopping_cart_item" data-component="{{componentname}}" data-area="{{area}}"
                    data-itemid="{{itemid}}" data-action="discount"
                    data-userid="{{userid}}"><i class="fa fa-fw fa-percent" aria-hidden="true"></i></button>
                </span>
            {{/iscashier}}
            {{^nodelete}}
            <span class="item-button pull-right">
                <button type="button" class="delete-button fa fa-fw fa-trash-o"
                aria-label="{{#str}} deleteitem, local_shopping_cart, {{itemname}} {{/str}}"
                data-item="shopping_cart_item" data-itemid="{{itemid}}" data-component="{{componentname}}"
                data-area="{{area}}" data-action="delete" data-userid="{{userid}}"></button>
            </span>
            {{/nodelete}}
            {{#nodelete}}
            <!-- This is only to fix indentation -->
            <span class="pull-right">
                <i class="fa fa-fw ps-2" aria-hidden="true"></i>
            </span>
            {{/nodelete}}
        </div>
        <div>
            <span class="itemname">
                {{#itemamount}}
                {{#str}} amount, local_shopping_cart {{/str}}: {{itemamount}}
                {{/itemamount}}
            </span>
        </div>
    </div>

    {{#iscashier}}
        <span class="item-button pull-right">
            <button type="button" class="sc-icon-button shoppingcart-modifytime-icon ps-2"
            aria-label="{{#str}} modifyreservationtimeitem, local_shopping_cart, {{itemname}} {{/str}}"
            data-item="shopping_cart_item" data-component="{{componentname}}" data-area="{{area}}"
            data-itemid="{{itemid}}" data-action="modifyreservationtime"
            data-userid="{{userid}}"><i class="fa fa-clock-o" aria-hidden="true"></i></button>
        </span>
    {{/iscashier}}
    <div class="pull-right">
        {{> local_shopping_cart/item_price }}
    </div>
    <div class="item-description">{{{description}}}</div>
</div>
